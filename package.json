{
  "name": "rezzo",
  "productName": "Rezzo",
  "version": "0.1.0",
  "private": true,
  "description": "Vertical clips from podcasts and talk shows",
  "license": "GPL-3.0-only",
  "author": "Nikola",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/renderer/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:e2e": "electron-vite build && vitest run --config vitest.e2e.config.mts",
    "fetch-tools": "node scripts/fetch-tools.mts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tanstack/react-virtual": "3.14.24",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.1.0",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "i18next": "26.5.11",
    "immer": "11.2.9",
    "mp4box": "2.5.0",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  }
}
