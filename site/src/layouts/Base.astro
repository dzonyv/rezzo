---
import '../styles/site.css';
import { absolute, asset, href, htmlLang, langs, ogLocale, type Lang, type Page } from '../i18n.ts';
import { repoUrl } from '../release.ts';
import { text } from '../text/index.ts';

interface Props {
  lang: Lang;
  page: Page;
  title: string;
  description: string;
  /** Structured data for search engines, written into the page as JSON-LD. */
  jsonLd?: object;
  bodyClass?: string;
}

const { lang, page, title, description, jsonLd, bodyClass } = Astro.props;
const t = text[lang].common;
const other: Lang = lang === 'sr' ? 'en' : 'sr';
const canonical = absolute(href(lang, page));
const ogImage = absolute(asset(`og-${lang}.png`));
const fonts = ['onest', 'unbounded', 'dm-mono'];
// The 404 page is served for any missing address, so it has no canonical address of its own.
const indexable = page !== '404';
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      indexable ? (
        <>
          <link rel="canonical" href={canonical} />
          {langs.map((l) => (
            <link rel="alternate" hreflang={htmlLang[l]} href={absolute(href(l, page))} />
          ))}
          <link rel="alternate" hreflang="x-default" href={absolute(href('sr', page))} />
        </>
      ) : (
        <meta name="robots" content="noindex" />
      )
    }
    <meta name="theme-color" content="#12110e" />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
    {fonts.map((f) => <link rel="preload" href={asset(`fonts/${f}.woff2`)} as="font" type="font/woff2" crossorigin />)}
    <style
      is:inline
      set:html={`@font-face{font-family:'Onest';src:url('${asset('fonts/onest.woff2')}') format('woff2');font-weight:400 700;font-display:swap}@font-face{font-family:'Unbounded';src:url('${asset('fonts/unbounded.woff2')}') format('woff2');font-weight:800;font-display:swap}@font-face{font-family:'DM Mono';src:url('${asset('fonts/dm-mono.woff2')}') format('woff2');font-weight:400;font-display:swap}`}
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rezzo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:locale:alternate" content={ogLocale[other]} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#sadrzaj">{t.skip}</a>
    <header class="wrap top">
      <a class="logo" href={href(lang, '')} aria-label={t.homeLabel}>
        <svg aria-hidden="true" viewBox="0 0 512 512">
          <defs>
            <clipPath id="logo-top"><path d="M0 0H512V296L0 368Z"></path></clipPath>
            <clipPath id="logo-bottom"><path d="M0 382L512 310V512H0Z"></path></clipPath>
          </defs>
          <rect x="16" y="16" width="480" height="480" rx="104" fill="#ffd400"></rect>
          <g clip-path="url(#logo-top)">
            <path d="M172 420V146H276a70 70 0 0 1 0 140H172M256 286L332 420" fill="none" stroke="#12110e" stroke-width="82"></path>
          </g>
          <g transform="translate(22 0)">
            <g clip-path="url(#logo-bottom)">
              <path d="M172 420V146H276a70 70 0 0 1 0 140H172M256 286L332 420" fill="none" stroke="#12110e" stroke-width="82"></path>
            </g>
          </g>
        </svg>
        <span aria-hidden="true">REZZO</span>
      </a>
      <nav aria-label={t.navLabel}>
        <a class="optional" href={href(lang, '', text[lang].home.howId)}>{t.nav.howItWorks}</a>
        <a class="optional" href={href(lang, 'uputstvo')}>{t.nav.guide}</a>
        <a class="optional" href={repoUrl}>{t.nav.github}</a>
        <a class="lang" href={href(other, page === '404' ? '' : page)} hreflang={htmlLang[other]} lang={htmlLang[other]} aria-label={t.otherLangLabel}>
          {t.otherLang}
        </a>
        <a class="button" href={href(lang, 'preuzmi')}>{t.nav.download}</a>
      </nav>
    </header>

    <main id="sadrzaj">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap">
        <p>{t.license} {t.madeBy} <a href="https://github.com/dzonyv">Nikola</a>.</p>
        <nav aria-label={t.footerNavLabel}>
          <a href={repoUrl}>GitHub</a>
          <a href={`${repoUrl}/issues`}>{t.report}</a>
          <a href={href(lang, 'izmene')}>{t.changes}</a>
          <a href={href(lang, 'licence')}>{t.licenses}</a>
        </nav>
        <p class="credit">{t.credit}</p>
      </div>
    </footer>
  </body>
</html>
