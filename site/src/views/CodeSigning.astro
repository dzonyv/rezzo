---
import Base from '../layouts/Base.astro';
import { href, type Lang } from '../i18n.ts';
import { text } from '../text/index.ts';

// The code signing policy SignPath Foundation asks for: what is signed, the
// team's roles, and the privacy statement in their words.

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = text[lang].signing;
const c = text[lang].common;
const english = text.en.signing.privacy[0];
---

<Base lang={lang} page="potpisivanje" title={t.title} description={t.description}>
  <div class="wrap narrow page-head">
    <h1 class="display">{t.h1}</h1>
    <p class="lead">{t.lead}</p>
  </div>
  <div class="wrap narrow prose">
    <p>{t.status}</p>
    <p class="statement" lang="en">
      Free code signing provided by <a href="https://signpath.io">SignPath.io</a>, certificate by <a href="https://signpath.org">SignPath Foundation</a>
    </p>

    <h2 class="display">{t.whatTitle}</h2>
    {t.what.map((p) => <p>{p}</p>)}
    <p><a href={href(lang, 'licence')}>{c.licenses}</a></p>

    <h2 class="display">{t.rolesTitle}</h2>
    <ul>
      {
        t.roles.map((r) => (
          <li>
            <strong>{r.role}:</strong> <a href="https://github.com/dzonyv">{r.who} (dzonyv)</a>. {r.note}
          </li>
        ))
      }
    </ul>

    <h2 class="display">{t.privacyTitle}</h2>
    {t.privacy.map((p) => <p>{p}</p>)}
    {
      t.privacyEnglish && (
        <p>
          {t.privacyEnglish} <q lang="en">{english}</q>
        </p>
      )
    }
    <ul>
      <li><a href="https://docs.github.com/site-policy/privacy-policies/github-general-privacy-statement">{t.githubPrivacy}</a></li>
      <li><a href="https://huggingface.co/privacy">{t.hfPrivacy}</a></li>
    </ul>
  </div>
</Base>
