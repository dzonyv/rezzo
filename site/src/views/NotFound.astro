---
import Base from '../layouts/Base.astro';
import { href, type Lang } from '../i18n.ts';
import { text } from '../text/index.ts';

// GitHub Pages serves one 404 page for every missing address, so it says
// the same thing in both languages, Serbian first.
const other: Lang = 'en';
const t = text.sr.notFound;
const o = text[other].notFound;
---

<Base lang="sr" page="404" title={t.title} description={t.description}>
  <div class="wrap narrow page-head prose">
    <h1 class="display">{t.h1}</h1>
    <p class="lead">{t.text}</p>
    <p><a class="button" href={href('sr', '')}>{t.back}</a></p>
    <div lang="en">
      <h2 class="display">{o.h1}</h2>
      <p>{o.text}</p>
      <p><a href={href('en', '')}>{o.back}</a></p>
    </div>
  </div>
</Base>
