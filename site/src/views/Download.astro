---
import DownloadMeta from '../components/DownloadMeta.astro';
import Slab from '../components/Slab.astro';
import Base from '../layouts/Base.astro';
import { href, type Lang } from '../i18n.ts';
import { latestRelease, repoUrl } from '../release.ts';
import { signed } from '../signing.ts';
import { text } from '../text/index.ts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = text[lang].download;
const c = text[lang].common;
const release = await latestRelease();
// While it isn't signed, the SmartScreen step goes second, right after running the installer.
const install = signed ? t.install : [t.install[0], t.installUnsigned, ...t.install.slice(1)];
---

<Base lang={lang} page="preuzmi" title={t.title} description={signed ? t.description : t.descriptionUnsigned}>
  <div class="download-box">
    <Slab labelledby="naslov">
      <Fragment slot="top">
        <div>
          <h1 id="naslov" class="display">{t.h1}</h1>
          <p class="slab-lead">{t.lead}</p>
          <DownloadMeta lang={lang} />
        </div>
        <a class="button dark" href={release.url}>{c.downloadButton}</a>
      </Fragment>
      <Fragment slot="bottom">
        <p>{t.checksum}</p>
        <a href={`${repoUrl}/releases`}>{t.allReleases}</a>
      </Fragment>
    </Slab>
  </div>

  <div class="wrap narrow prose">
    <h2 class="display">{t.needsTitle}</h2>
    <ul>{t.needs.map((n) => <li>{n}</li>)}</ul>

    <h2 class="display">{t.installTitle}</h2>
    <ol>{install.map((n) => <li>{n}</li>)}</ol>

    <h2 class="display">{t.removeTitle}</h2>
    <p>{t.remove}</p>

    <h2 class="display">{t.buildTitle}</h2>
    <p>{t.build}</p>
    <pre><code>npm install
npm run fetch-tools
npm run dev</code></pre>
    <p><a href={`${repoUrl}#readme`}>{t.readme}</a></p>

    <h2 class="display">{c.signing}</h2>
    <p>{signed ? t.signingText : t.signingTextUnsigned} <a href={href(lang, 'potpisivanje')}>{c.signing}</a></p>
  </div>
</Base>
